# ============================================================
# Task Tracker Pro - biến môi trường
# Sao chép thành .env.local rồi điền giá trị. Bỏ trống = chạy chế độ Demo.
# ============================================================

# --- Địa chỉ app (dùng cho link trong thông báo) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Múi giờ để tính "hôm nay" cho cron
APP_TIMEZONE=Asia/Ho_Chi_Minh

# --- 1. Firebase phía trình duyệt (Project settings > General > Your apps > Web app) ---
# Điền đủ 6 dòng này là app tự chuyển từ Demo sang đăng nhập thật + Firestore.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- 2. Firebase Admin phía server (Project settings > Service accounts > Generate new private key) ---
# Cần cho cron, lịch đồng bộ và xác thực API khi chạy Production.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Dán nguyên khóa, giữ các ký tự \n
FIREBASE_ADMIN_PRIVATE_KEY=

# --- 3. Bảo vệ endpoint ---
# Vercel Cron tự gửi header Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
# Mã bí mật cho link lịch .ics đăng ký vào Google Calendar
CALENDAR_FEED_TOKEN=

# --- 4. Kênh thông báo (có thể điền ở đây hoặc trong trang Cài đặt tích hợp) ---
# Zalo: chọn 1 trong 2 cách
ZALO_WEBHOOK_URL=
ZALO_OA_ACCESS_TOKEN=
# Danh sách user_id người nhận của OA, cách nhau dấu phẩy
ZALO_OA_USER_IDS=

# Telegram
TELEGRAM_BOT_TOKEN=
# Chat ID cá nhân (số dương) hoặc nhóm (số âm, ví dụ -1001234567890)
TELEGRAM_CHAT_ID=

# Email: provider = resend hoặc smtp
EMAIL_PROVIDER=resend
EMAIL_FROM=Task Tracker Pro <no-reply@yourdomain.com>
# Người nhận báo cáo, cách nhau dấu phẩy
EMAIL_TO=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Webhook mở rộng (Lark / Slack / Discord / Custom)
LARK_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
CUSTOM_WEBHOOK_URL=
